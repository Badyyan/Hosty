{
  "name": "hosty",
  "version": "1.0.0",
  "private": true,
  "description": "Hosty \u2014 a modern static hosting platform. Upload a site, document or image and get a public URL in seconds.",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "db:seed": "prisma db seed",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "preview:cf": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy:cf": "opennextjs-cloudflare build && opennextjs-cloudflare deploy"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.575.0",
    "@aws-sdk/lib-storage": "^3.575.0",
    "@aws-sdk/s3-request-presigner": "^3.575.0",
    "@codemirror/lang-css": "^6.2.1",
    "@codemirror/lang-html": "^6.4.9",
    "@codemirror/lang-javascript": "^6.2.2",
    "@codemirror/lang-markdown": "^6.2.5",
    "@next-auth/prisma-adapter": "^1.0.7",
    "@opennextjs/cloudflare": "^1.13.0",
    "@prisma/adapter-pg": "^5.22.0",
    "@prisma/client": "^5.14.0",
    "@uiw/react-codemirror": "^4.22.1",
    "adm-zip": "^0.5.12",
    "bcryptjs": "^2.4.3",
    "date-fns": "^3.6.0",
    "graphql": "^16.14.2",
    "graphql-yoga": "^5.21.2",
    "ioredis": "^5.4.1",
    "mime-types": "^2.1.35",
    "nanoid": "^5.0.7",
    "next": "^14.2.35",
    "next-auth": "^4.24.7",
    "nodemailer": "^7.0.7",
    "otplib": "^12.0.1",
    "pg": "^8.22.0",
    "qrcode": "^1.5.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.12.7",
    "stripe": "^15.8.0",
    "ua-parser-js": "^1.0.38",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/adm-zip": "^0.5.5",
    "@types/bcryptjs": "^2.4.6",
    "@types/mime-types": "^2.1.4",
    "@types/node": "^20.12.12",
    "@types/nodemailer": "^7.0.0",
    "@types/pg": "^8.20.0",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^18.3.2",
    "@types/react-dom": "^18.3.0",
    "@types/ua-parser-js": "^0.7.39",
    "autoprefixer": "^10.4.19",
    "postcss": "^8.4.38",
    "prisma": "^5.14.0",
    "tailwindcss": "^3.4.3",
    "tsx": "^4.10.5",
    "typescript": "^5.4.5",
    "vitest": "^1.6.0",
    "wrangler": "^4.110.0"
  },
  "engines": {
    "node": ">=18.17.0"
  }
}