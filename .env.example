# ---------------------------------------------------------------------------
# Hosty environment configuration
# Copy to .env and fill in values. Never commit .env.
# ---------------------------------------------------------------------------

# --- Core --------------------------------------------------------------------
# Public URL of the dashboard app (no trailing slash)
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Root domain that hosted sites are served from, e.g. mysite.hosty.site
NEXT_PUBLIC_ROOT_DOMAIN=localhost:3000
NODE_ENV=development

# --- Database (PostgreSQL) ---------------------------------------------------
DATABASE_URL=postgresql://hosty:hosty@localhost:5432/hosty?schema=public

# --- Redis (rate limiting, caching, sessions for analytics) ------------------
REDIS_URL=redis://localhost:6379

# --- Auth (NextAuth) ----------------------------------------------------------
NEXTAUTH_URL=http://localhost:3000
# openssl rand -base64 32
NEXTAUTH_SECRET=change-me-in-production
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- Object storage (AWS S3 or any S3-compatible store, e.g. MinIO/R2) -------
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=hosty-sites
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
# Set to "true" for MinIO / path-style buckets
S3_FORCE_PATH_STYLE=true

# --- Stripe billing -----------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_BUSINESS_MONTHLY=

# --- Email (SMTP) -------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM="Hosty <no-reply@hosty.site>"

# --- Malware scanning (optional ClamAV daemon) --------------------------------
CLAMAV_HOST=
CLAMAV_PORT=3310

# --- Misc ---------------------------------------------------------------------
# HMAC secret for signed cookies (password gates), webhook signatures, etc.
SIGNING_SECRET=change-me-too
